# ==========================================
# Signal — Local Development Configuration
# Copy this file to .env and fill in your values
# ==========================================

# Database (local SQLite file; in OpenShift this points to the PVC: sqlite:////app/data/signal.db)
DATABASE_URL=sqlite:///./data/signal.db

# Session signing secret (generate a random string for production / OpenShift Secret)
SESSION_SECRET_KEY=change-me-in-production-signal-secret

# Initial Admins (comma-separated, supports "ad\username" or "username")
# Mirrors OpenShift ConfigMap INITIAL_ADMINS
INITIAL_ADMINS=ad\admin

# Optional public base URL (e.g. OpenShift Route URL; leave blank for browser origin)
PUBLIC_BASE_URL=

# ------------------------------------------
# LDAPS Pass-Through Bind (Optional)
# Leave LDAP_ENABLED=false for local dev (grants admin access until configured)
# ------------------------------------------
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=636
LDAP_USE_SSL=true
LDAP_USER_DOMAIN=ad
LDAP_AUTH_TYPE=SIMPLE

# ------------------------------------------
# Twilio SMS Configuration (Required for real SMS delivery)
# Use EITHER Account SID + Auth Token OR Account SID + API Key SID & Secret
# ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# Provide EITHER a Twilio Messaging Service SID (MG...) OR a From phone number (+1...)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
