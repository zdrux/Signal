# Use pip's default package index unless overridden for internal Artifactory / Nexus.
# Any credentials placed here are stripped out of the image during Dockerfile build.
[global]
# index-url = https://<user>:<token>@artifactory.corp.internal/artifactory/api/pypi/pypi-virtual/simple
# trusted-host = artifactory.corp.internal
# cert = /etc/pki/tls/certs/ca-bundle.crt
